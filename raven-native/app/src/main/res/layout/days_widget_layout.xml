<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/days_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/days_widget_bg">
    <ImageView android:id="@+id/days_bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:visibility="gone" />
    <View android:id="@+id/days_scrim" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#40000000" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:id="@+id/days_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="阿颖和阿言" android:textColor="#99948A7C" android:textSize="11sp" android:letterSpacing="0.1" />
            <TextView android:id="@+id/days_pick" android:layout_width="28dp" android:layout_height="28dp" android:gravity="center"
                android:text="🖼" android:textSize="13sp" android:alpha="0.7" />
        </LinearLayout>
        <TextView android:id="@+id/days_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textColor="#FFB0784A" android:textSize="24sp" android:textStyle="bold"
            android:shadowColor="#33000000" android:shadowRadius="2" />
        <TextView android:id="@+id/days_line" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:layout_marginTop="6dp" android:gravity="center_vertical" android:maxLines="3" android:ellipsize="end"
            android:textColor="#FF3A332B" android:textSize="14sp" android:lineSpacingExtra="3dp"
            android:shadowColor="#33000000" android:shadowRadius="2" />
    </LinearLayout>
</FrameLayout>
