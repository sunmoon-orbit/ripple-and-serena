<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/board_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg">
    <ImageView android:id="@+id/board_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="便利贴" android:textColor="#FFFFFFFF" android:textStyle="bold" android:textSize="15sp" />
        <TextView android:id="@+id/board_add" android:layout_width="34dp" android:layout_height="34dp" android:gravity="center" android:text="＋" android:textColor="#FFFFFFFF" android:textSize="23sp" android:background="@drawable/widget_action_bg" />
    </LinearLayout>
    <TextView android:id="@+id/board_text" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:maxLines="4" android:ellipsize="end" android:textColor="#F2FFFFFF" android:textSize="14sp" android:lineSpacingExtra="3dp" />
    <TextView android:id="@+id/board_author" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:textColor="#AAFFFFFF" android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
