<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_compose_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/widget_compose_decor_top"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:alpha="0.24"
        android:src="@drawable/widget_dialog_sprig" />

    <ImageView
        android:id="@+id/widget_compose_decor_bottom"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="10dp"
        android:alpha="0.16"
        android:rotation="180"
        android:src="@drawable/widget_dialog_sprig" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

    <TextView
        android:id="@+id/widget_compose_kicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.18" />

    <TextView
        android:id="@+id/widget_compose_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_compose_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/widget_compose_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="96dp"
        android:layout_marginTop="17dp"
        android:padding="15dp"
        android:gravity="top|start"
        android:backgroundTint="@android:color/transparent"
        android:textSize="15sp"
        android:lineSpacingExtra="3dp"
        android:inputType="textCapSentences|textMultiLine" />

    <CheckBox
        android:id="@+id/widget_compose_repeat"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:buttonTint="@android:color/white"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        android:text="每天重复"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_compose_manage_repeat"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        android:text="管理每日重复  ›"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_compose_cancel"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="78dp"
            android:gravity="center"
            android:text="先不写"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_compose_submit"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="92dp"
            android:layout_marginStart="10dp"
            android:gravity="center"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
    </LinearLayout>
</FrameLayout>
