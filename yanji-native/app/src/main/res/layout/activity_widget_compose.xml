<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_compose_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:id="@+id/widget_compose_kicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.18" />

    <TextView
        android:id="@+id/widget_compose_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_compose_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/widget_compose_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="96dp"
        android:layout_marginTop="17dp"
        android:padding="15dp"
        android:gravity="top|start"
        android:backgroundTint="@android:color/transparent"
        android:textSize="15sp"
        android:lineSpacingExtra="3dp"
        android:inputType="textCapSentences|textMultiLine" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_compose_cancel"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="78dp"
            android:gravity="center"
            android:text="先不写"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_compose_submit"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="92dp"
            android:layout_marginStart="10dp"
            android:gravity="center"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
