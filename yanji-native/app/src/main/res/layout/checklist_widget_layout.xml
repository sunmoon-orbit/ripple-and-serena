<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/checklist_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg">
    <ImageView android:id="@+id/checklist_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="15dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/checklist_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="今 日 小 票" android:textColor="#FFFFFFFF" android:textStyle="bold" android:textSize="15sp" />
        <ImageView android:id="@+id/checklist_calendar" android:layout_width="30dp" android:layout_height="30dp" android:padding="7dp" android:src="@drawable/ic_widget_calendar" android:tint="#EEFFFFFF" android:background="@drawable/widget_action_bg" android:layout_marginEnd="5dp" />
        <TextView android:id="@+id/checklist_add" android:layout_width="34dp" android:layout_height="34dp" android:gravity="center" android:text="＋" android:textColor="#FFFFFFFF" android:textSize="23sp" android:background="@drawable/widget_action_bg" />
    </LinearLayout>
    <TextView android:id="@+id/checklist_summary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#BBFFFFFF" android:textSize="10sp" android:layout_marginBottom="5dp" />
    <TextView android:id="@+id/checklist_item_1" style="@style/WidgetLine" />
    <TextView android:id="@+id/checklist_item_2" style="@style/WidgetLine" />
    <TextView android:id="@+id/checklist_item_3" style="@style/WidgetLine" />
    <TextView android:id="@+id/checklist_habit_week" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="·  ·  ·  ·  ·  ·  ·" android:textColor="#CCFFFFFF" android:textSize="11sp" android:letterSpacing="0.08" android:layout_marginTop="3dp" />
    </LinearLayout>
</FrameLayout>
